---
import "../styles/global.css";
import CountySelector from "../components/CountySelector.astro";
import PipelineFlow from "../components/PipelineFlow.astro";
import manifest from "../data/manifest.json";

const liveCounties = manifest.filter((c: any) => c.is_live);
const plannedCounties = manifest.filter((c: any) => !c.is_live);

const countyFiles = import.meta.glob('../data/counties/*.json', { eager: true });
const getCountyData = (slug: string): any => {
  const path = `../data/counties/${slug}.json`;
  return (countyFiles[path] as any)?.default || countyFiles[path] || {};
};

const adapterLabels: Record<string, string> = {
  dekalb_pdf: "Mainframe PDF (DQ205GADEK)",
  gwinnett_xlsx: "Weekly XLSX roll",
  cobb_pdf: "Monthly delinquent PDF",
  fulton_sheriff: "Scanned PDF OCR",
};

// Platform totals — computed live from the county JSONs, so they climb on their own.
const totalTracked = liveCounties.reduce((s: number, c: any) => s + (c.total_due || 0), 0);
const totalRecords = liveCounties.reduce((s: number, c: any) => s + (c.records || 0), 0);

const fmtCompactMoney = (n: number): string =>
  n >= 1_000_000 ? `$${(n / 1_000_000).toFixed(2)}M`
  : n >= 10_000 ? `$${(n / 1_000).toFixed(1)}K`
  : `$${(n || 0).toFixed(0)}`;
const fmtInt = (n: number): string => (n || 0).toLocaleString("en-US");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="GAScout — statewide Georgia public-records pipeline. Live delinquent-roll and tax-sale data for multiple counties, every figure aggregate and traceable to an official source." />
    <title>GAScout — Georgia Public Records Pipeline</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <div class="hero-grid">
          <div>
            <div class="brand-row">
              <div class="logo-badge">
                <span class="pulse-dot"></span>
                {liveCounties.length} COUNTIES LIVE
              </div>
              <span style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted); background: var(--bg-glass); padding: 4px 12px; border-radius: 999px; border: 1px solid var(--border-glass);">
                159-county Georgia registry
              </span>
            </div>

            <h1 class="hero-title">
              GA<span class="brand-highlight">Scout</span> Intelligence Engine
            </h1>

            <p class="hero-subtitle">
              A statewide Georgia public-records pipeline. Official county filings turned into clean, aggregate data — every figure traceable to its source, zero mock numbers.
            </p>

            <div class="hero-meta">
              <span>🏛️ Sources: <strong>County Tax Commissioner &amp; Sheriff filings</strong></span>
              <span>•</span>
              <span>🛡️ Integrity: <strong>Zero Mock Data Policy</strong></span>
            </div>

            <CountySelector currentSlug="" />
          </div>

        </div>
      </div>
    </header>

    <main class="wrap main-content">
      <!-- Platform stat band — all computed live from the county data -->
      <section class="stats-grid" aria-label="GAScout platform statistics" style="margin-bottom: 8px;">
        <div class="stat-card-glass accent-cyan"><span class="stat-value">{fmtCompactMoney(totalTracked)}</span><span class="stat-label">Delinquent Taxes Tracked</span><div class="stat-desc">Across {liveCounties.length} live county rolls</div></div>
        <div class="stat-card-glass accent-emerald"><span class="stat-value">{fmtInt(totalRecords)}</span><span class="stat-label">Records Parsed</span><div class="stat-desc">From official county filings</div></div>
        <div class="stat-card-glass accent-cyan"><span class="stat-value">{liveCounties.length} <span style="color:var(--text-faint);font-size:1.1rem;">/ 159</span></span><span class="stat-label">Counties Live</span><div class="stat-desc">Rest on the registry roadmap</div></div>
        <div class="stat-card-glass accent-amber"><span class="stat-value">Zero</span><span class="stat-label">Mock Data</span><div class="stat-desc">Every number source-verified</div></div>
      </section>

      <section class="analysis-section glass-panel">
        <div class="section-header">
          <span class="section-icon">🗺️</span>
          <div>
            <h2>Georgia Statewide Pipeline Registry</h2>
            <p>{liveCounties.length} live production {liveCounties.length === 1 ? 'county' : 'counties'}, all 159 on the roadmap. Select any to inspect its dashboard or adapter status.</p>
          </div>
        </div>

        <div class="county-hub-grid">
          {liveCounties.map((c: any) => {
            const data = getCountyData(c.slug);
            const isSaleList = data.has_amounts === false;
            const adapterLabel = adapterLabels[data.adapter] || data.adapter || 'live';
            return (
              <a href={`/${c.slug}`} class="county-card">
                <div class="county-card__head">
                  <span class="county-card__name">{c.name} County</span>
                  <span class="county-card__badge"><span class="county-card__dot"></span>{isSaleList ? 'LIVE · SALE LIST' : 'LIVE'}</span>
                </div>
                <div class="county-card__stats">
                  {isSaleList ? (
                    <>
                      <div><div class="county-stat__val county-stat__val--accent">{fmtInt(c.records)}</div><div class="county-stat__lbl">Auction properties</div></div>
                      <div><div class="county-stat__val">{data.sale_date}</div><div class="county-stat__lbl">Sheriff sale</div></div>
                    </>
                  ) : (
                    <>
                      <div><div class="county-stat__val county-stat__val--accent">{fmtCompactMoney(c.total_due)}</div><div class="county-stat__lbl">Tracked</div></div>
                      <div><div class="county-stat__val">{fmtInt(c.records)}</div><div class="county-stat__lbl">Records</div></div>
                      {data.parcels ? (<div><div class="county-stat__val">{fmtInt(data.parcels)}</div><div class="county-stat__lbl">Parcels</div></div>) : null}
                    </>
                  )}
                </div>
                <div class="county-card__foot">
                  <span class="county-card__adapter">{adapterLabel}</span>
                  <span class="county-card__link">View dashboard →</span>
                </div>
              </a>
            );
          })}

          {plannedCounties.slice(0, 9).map((c: any) => (
            <a href={`/${c.slug}`} class="county-card">
              <div class="county-card__head">
                <span class="county-card__name">{c.name} County</span>
                <span class="county-card__badge county-card__badge--planned">PLANNED</span>
              </div>
              <div class="county-card__planned-body">{c.legal_organ}</div>
              <div class="county-card__foot">
                <span class="county-card__adapter">{c.seat}</span>
                <span class="county-card__link county-card__link--planned">Adapter status →</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <PipelineFlow />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-content">
        <div>
          <div style="font-weight: 700; color: var(--text-primary); margin-bottom: 4px;">
            GAScout Intelligence Engine — Statewide Georgia Public Records Platform
          </div>
          <div>
            Built with Astro &amp; Vanilla CSS. Aggregate figures only; every number traceable to an official county source.
          </div>
        </div>
        <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted);">
          Zero Mock Data • Source-Verified
        </div>
      </div>
    </footer>
  </body>
</html>
