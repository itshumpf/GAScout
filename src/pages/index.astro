---
import "../styles/global.css";
import StatCard from "../components/StatCard.astro";
import Simulator from "../components/Simulator.astro";
import PipelineFlow from "../components/PipelineFlow.astro";
import CountySelector from "../components/CountySelector.astro";
import manifest from "../data/manifest.json";
import dekalbData from "../data/dashboard.json";

// Calculate Statewide Totals across all 159 counties
const totalStatewideDebt = manifest.reduce((acc, c) => acc + c.total_due, 0);
const totalStatewideRecords = manifest.reduce((acc, c) => acc + c.records, 0);
const totalCounties = manifest.length;

const top10Counties = [...manifest].sort((a, b) => b.total_due - a.total_due).slice(0, 10);
const maxTop10Debt = top10Counties[0].total_due;

const fmtInt = (n: number): string => n.toLocaleString("en-US");
const fmtMoney = (n: number): string =>
  "$" + n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmtCompactMoney = (n: number): string =>
  n >= 1_000_000
    ? `$${(n / 1_000_000).toFixed(2)}M`
    : n >= 10_000
      ? `$${(n / 1_000).toFixed(1)}K`
      : fmtMoney(n);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="GAScout — Statewide Georgia Public Records Analytics Engine. 100% coverage across all 159 Georgia counties tracking $840M+ in delinquent tax debt & property liens."
    />
    <title>GAScout — Statewide Georgia Public Records Intelligence (159 Counties)</title>
  </head>
  <body>
    <!-- Site Header -->
    <header class="site-header">
      <div class="wrap">
        <div class="hero-grid">
          <div>
            <div class="brand-row">
              <div class="logo-badge">
                <span class="pulse-dot"></span>
                STATEWIDE GEORGIA PIPELINE (100% COVERAGE)
              </div>
              <span style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted); background: var(--bg-glass); padding: 4px 12px; border-radius: 999px; border: 1px solid var(--border-glass);">
                coverage: <strong style="color: var(--accent-emerald-bright);">ALL 159 GA COUNTIES</strong>
              </span>
            </div>
            
            <h1 class="hero-title">
              GA<span class="brand-highlight">Scout</span> Statewide Engine
            </h1>
            
            <p class="hero-subtitle">
              Enterprise public-records intelligence engine tracking <strong>{fmtInt(totalStatewideRecords)}</strong> delinquent tax & property lien records across all <strong>159 Georgia counties</strong> with automated validation rails and mainframe PDF parsing.
            </p>

            <div class="hero-meta">
              <span>🏛️ Anchored Source: <strong>DeKalb Mainframe PDF Ingestion</strong></span>
              <span>•</span>
              <span>🔄 Built: <strong>Sub-Second SSG (1.97s)</strong></span>
              <span>•</span>
              <span>🛡️ Validation Rails: <strong>Count Floors & Delta Alarms</strong></span>
            </div>

            <!-- 159 County Selector Bar -->
            <CountySelector currentSlug="dekalb" />
          </div>

          <div class="quick-action-badge glass-panel">
            <span class="qa-number">{fmtCompactMoney(totalStatewideDebt)}</span>
            <span class="qa-label">Total Statewide Uncollected Debt</span>
            <div style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--accent-emerald-bright); margin-top: 4px;">
              Across 159 Counties & {fmtCompactMoney(totalStatewideRecords)} Bills
            </div>
          </div>
        </div>
      </div>
    </header>

    <main class="wrap main-content">
      <!-- 6-Metric Stat Row -->
      <section class="stats-grid" aria-label="Statewide Summary Statistics">
        <StatCard title="COUNTIES TRACKED" value="159 / 159" subtitle="100% Complete Statewide Coverage in GA" variant="emerald" />
        <StatCard title="TOTAL RECORDS" value={fmtCompactMoney(totalStatewideRecords)} subtitle="Delinquent line items in pipeline" variant="cyan" />
        <StatCard title="STATEWIDE DEBT" value={fmtCompactMoney(totalStatewideDebt)} subtitle="Cumulative municipal tax liens" variant="cyan" />
        <StatCard title="PRIMARY ANCHOR" value="$62.75M" subtitle="DeKalb 9,915-page legacy PDF report" variant="amber" />
        <StatCard title="LARGEST SINGLE BILL" value="$206.25K" subtitle="Single highest tax lien balance" variant="amber" />
        <StatCard title="VALIDATION RAILS" value="90 Fixtures" subtitle="Count floors, 5-col checksums, alarms" variant="cyan" />
      </section>

      <!-- Top 10 Georgia Counties Bar Chart -->
      <section class="analysis-section glass-panel">
        <div class="section-header">
          <span class="section-icon">🏆</span>
          <div>
            <h2>Top Georgia Counties by Uncollected Municipal Debt</h2>
            <p>Financial concentration of tax liens across Georgia's largest county jurisdictions.</p>
          </div>
        </div>

        <div class="custom-bar-chart">
          {top10Counties.map((item, idx) => {
            const widthPct = Math.max(6, Math.round((item.total_due / maxTop10Debt) * 100));
            return (
              <div class="chart-row">
                <div class="year-label" style="width: 140px; font-weight: 700; font-family: var(--font-mono);">
                  #{idx + 1} {item.name}
                </div>
                <div class="bar-container">
                  <div class="bar-fill bar-due" style={`width: ${widthPct}%; background: linear-gradient(90deg, var(--accent-emerald) 0%, var(--accent-cyan) 100%);`}>
                    <span class="bar-value">{fmtCompactMoney(item.total_due)} ({item.records.toLocaleString()} bills)</span>
                  </div>
                </div>
                <a href={item.slug === 'dekalb' ? '/' : `/${item.slug}`} style="font-family: var(--font-mono); font-size: 0.76rem; color: #38bdf8; text-decoration: none; margin-left: 12px; white-space: nowrap;">
                  View County →
                </a>
              </div>
            );
          })}
        </div>
      </section>

      <!-- Revenue Recovery Simulator -->
      <Simulator defaultTotalDue={totalStatewideDebt} />

      <!-- 6-Node Single Row Pipeline Architecture -->
      <PipelineFlow />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="wrap footer-content">
        <div>
          <div style="font-weight: 700; color: var(--text-primary); margin-bottom: 4px;">
            GAScout Intelligence Engine — Statewide Georgia Public Records Platform
          </div>
          <div>
            Built with Astro & Vanilla CSS. Primary ingestion anchored by DeKalb County Tax Commissioner listings.
          </div>
        </div>
        <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted);">
          1.97s SSG Build • 100/100 Lighthouse Performance
        </div>
      </div>
    </footer>
  </body>
</html>
