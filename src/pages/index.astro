---
import "../styles/global.css";
import StatCard from "../components/StatCard.astro";
import Simulator from "../components/Simulator.astro";
import PipelineFlow from "../components/PipelineFlow.astro";
import dashboard from "../data/dashboard.json";

const {
  generated_at,
  county,
  source,
  run_date,
  records,
  owners,
  total_due,
  by_year,
  amount_bands,
  flags,
  median_due,
  largest_single_bill,
} = dashboard;

const fmtInt = (n: number): string => n.toLocaleString("en-US");
const fmtMoney = (n: number): string =>
  "$" + n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmtCompactMoney = (n: number): string =>
  n >= 1_000_000
    ? `$${(n / 1_000_000).toFixed(2)}M`
    : n >= 10_000
      ? `$${(n / 1_000).toFixed(1)}K`
      : fmtMoney(n);

const years = Object.entries(by_year).map(([year, v]) => ({
  year,
  records: v.records,
  due: v.due,
  avgDue: v.due / v.records,
}));

const yearRange = `${years[0].year}–${years[years.length - 1].year}`;
const maxYearRecords = Math.max(...years.map((y) => y.records));
const maxYearDue = Math.max(...years.map((y) => y.due));
const maxYearAvg = Math.max(...years.map((y) => y.avgDue));

const bands = Object.entries(amount_bands).map(([label, count]) => ({
  label,
  count,
  pct: (count / records) * 100,
}));
const maxBand = Math.max(...bands.map((b) => b.count));

const avgRecordsPerOwner = (records / owners).toFixed(1);
const y2025PctDebt = ((by_year["2025"].due / total_due) * 100).toFixed(1);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="GAScout — Georgia Public Records Analytics. Aggregate intelligence and statistics from county-published delinquent tax listings."
    />
    <title>GAScout — Georgia Public Records Pipeline & Analytics</title>
  </head>
  <body>
    <!-- Site Header -->
    <header class="site-header">
      <div class="wrap">
        <div class="hero-grid">
          <div>
            <div class="brand-row">
              <div class="logo-badge">
                <span class="pulse-dot"></span>
                LIVE PUBLIC RECORDS PIPELINE
              </div>
              <span style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted); background: var(--bg-glass); padding: 4px 12px; border-radius: 999px; border: 1px solid var(--border-glass);">
                county: <strong style="color: var(--accent-emerald-bright);">{county.toUpperCase()}</strong>
              </span>
            </div>
            
            <h1 class="hero-title">
              GA<span class="brand-highlight">Scout</span> Intelligence
            </h1>
            
            <p class="hero-subtitle">
              Aggregate public-records analytics from DeKalb County delinquent tax listings. Uncovering financial concentration, tax liens, and long-tail property trends.
            </p>

            <div class="hero-meta">
              <span>📅 Run Date: <strong>{run_date}</strong></span>
              <span>•</span>
              <span>🔄 Generated: <strong>{generated_at}</strong></span>
              <span>•</span>
              <span>🏛️ Source: DeKalb Tax Commissioner</span>
            </div>

            <!-- County Switcher -->
            <div style="display: flex; align-items: center; gap: 8px; margin-top: 16px; font-family: var(--font-mono); font-size: 0.78rem; flex-wrap: wrap;">
              <span style="color: var(--text-muted);">GA Counties:</span>
              <a href="/" style="color: var(--accent-emerald-bright); font-weight: 700; text-decoration: none; padding: 4px 8px; border-radius: 6px; border: 1px solid var(--accent-emerald-bright); background: rgba(16, 185, 129, 0.1);">DeKalb (409k)</a>
              <a href="/fulton" style="color: var(--text-muted); text-decoration: none; padding: 4px 8px; border-radius: 6px; border: 1px solid var(--border-subtle);">Fulton</a>
              <a href="/gwinnett" style="color: var(--text-muted); text-decoration: none; padding: 4px 8px; border-radius: 6px; border: 1px solid var(--border-subtle);">Gwinnett</a>
              <a href="/cobb" style="color: var(--text-muted); text-decoration: none; padding: 4px 8px; border-radius: 6px; border: 1px solid var(--border-subtle);">Cobb</a>
              <a href="/chatham" style="color: var(--text-muted); text-decoration: none; padding: 4px 8px; border-radius: 6px; border: 1px solid var(--border-subtle);">Chatham</a>
              <a href="/cherokee" style="color: var(--text-muted); text-decoration: none; padding: 4px 8px; border-radius: 6px; border: 1px solid var(--border-subtle);">Cherokee</a>
            </div>
          </div>

          <div class="quick-action-badge glass-panel">
            <span class="qa-number">{fmtCompactMoney(total_due)}</span>
            <span class="qa-label">Total Uncollected Debt</span>
            <div style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--accent-emerald-bright); margin-top: 4px;">
              Across {fmtInt(records)} Property Bills
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="wrap">
      
      <!-- Key Stat Cards -->
      <section class="section" aria-label="Dataset Summary Metrics">
        <div class="stats-grid">
          <StatCard
            value={fmtInt(records)}
            label="Total Records"
            description="Delinquent line items in county dataset"
            variant="emerald"
          />
          <StatCard
            value={fmtInt(owners)}
            label="Unique Owners"
            description={`Avg ${avgRecordsPerOwner} delinquent bills per owner`}
            variant="cyan"
          />
          <StatCard
            value={fmtCompactMoney(total_due)}
            label="Total Debt Due"
            description="Cumulative tax debt (2018–2025)"
            variant="emerald"
          />
          <StatCard
            value={fmtMoney(median_due)}
            label="Median Bill"
            description="77.8% of records are under $100"
            variant="amber"
          />
          <StatCard
            value={fmtCompactMoney(largest_single_bill)}
            label="Largest Bill"
            description="Single highest tax lien balance"
            variant="amber"
          />
          <StatCard
            value={yearRange}
            label="Tax Years"
            description={`8-year span (${y2025PctDebt}% due in 2025)`}
            variant="cyan"
          />
        </div>
      </section>

      <!-- Multi-Metric Year Analytics -->
      <section class="section" aria-label="Tax Year Analytics">
        <div class="section-header-box">
          <h2 class="section-title">
            <span class="title-icon">📊</span>
            Tax Year Trend Analysis
          </h2>
          <p class="section-subtitle">
            Delinquency distribution across eight tax cycles ({yearRange}). Recent cycles account for the majority of outstanding dollars, while earlier tax years represent persistent zombie properties.
          </p>
        </div>

        <div class="chart-panel">
          <div class="chart-controls">
            <div class="metric-toggle-group" id="year-chart-toggles">
              <button class="btn-toggle active" data-metric="due">Total Debt ($)</button>
              <button class="btn-toggle" data-metric="records">Record Count</button>
              <button class="btn-toggle" data-metric="avg">Avg Bill / Record ($)</button>
            </div>
            
            <div class="chart-legend">
              <span class="legend-item"><span class="legend-swatch swatch-due"></span> Total Due ($)</span>
              <span class="legend-item"><span class="legend-swatch swatch-records"></span> Volume (Records)</span>
              <span class="legend-item"><span class="legend-swatch swatch-avg"></span> Avg Bill ($)</span>
            </div>
          </div>

          <div class="bars-container" id="year-bars-container">
            {years.map(({ year, records: n, due, avgDue }) => {
              const duePct = (due / maxYearDue) * 100;
              const recPct = (n / maxYearRecords) * 100;
              const avgPct = (avgDue / maxYearAvg) * 100;
              return (
                <div class="bar-item-row" data-year={year} data-due={due} data-records={n} data-avg={avgDue}>
                  <span class="year-label">{year}</span>
                  <div class="bar-track-wrapper">
                    <!-- Default view is Total Due -->
                    <div 
                      class="bar-fill fill-due" 
                      style={`width: ${Math.max(duePct, 5)}%`} 
                      data-width-due={`${duePct}%`}
                      data-width-records={`${recPct}%`}
                      data-width-avg={`${avgPct}%`}
                    >
                      <span class="bar-text-val">{fmtCompactMoney(due)}</span>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>

      <!-- Amount Bands & Pareto Distribution -->
      <section class="section" aria-label="Amount Bands Breakdown">
        <div class="two-col-grid">
          
          <!-- Amount Bands Chart -->
          <div class="glass-panel" style="padding: 28px;">
            <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 6px; display: flex; align-items: center; gap: 8px;">
              <span>🏷️</span> Bill Size Distribution
            </h3>
            <p style="font-size: 0.86rem; color: var(--text-muted); margin-bottom: 20px;">
              Volume of records grouped by total dollar liability.
            </p>

            <div class="bars-container">
              {bands.map(({ label, count, pct }) => (
                <div class="bar-item-row" style="grid-template-columns: 75px 1fr;">
                  <span class="year-label" style="text-align: left; font-size: 0.82rem;">{label}</span>
                  <div class="bar-track-wrapper">
                    <div class="bar-fill fill-records" style={`width: ${Math.max((count / maxBand) * 100, 8)}%`}>
                      <span class="bar-text-val">{fmtInt(count)} ({pct.toFixed(1)}%)</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Pareto Insight Card -->
          <div class="glass-panel" style="padding: 28px; background: linear-gradient(135deg, rgba(17, 24, 39, 0.8) 0%, rgba(15, 23, 42, 0.9) 100%);">
            <span style="font-family: var(--font-mono); font-size: 0.72rem; padding: 3px 10px; border-radius: 999px; background: rgba(245, 158, 11, 0.15); color: var(--accent-amber-bright); border: 1px solid rgba(245, 158, 11, 0.3);">
              ECONOMIC PARETO PRINCIPLE
            </span>
            <h3 style="font-size: 1.25rem; font-weight: 800; margin: 12px 0 10px; color: #ffffff;">
              Micro-Bills vs. Portfolio Debt
            </h3>
            <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.6;">
              <strong style="color: var(--accent-emerald-bright);">318,431 records (77.8%)</strong> are small balances under $100. These represent massive administrative mailing overhead for relatively low monetary recovery.
            </p>
            <div style="margin-top: 16px; padding: 16px; background: rgba(10, 15, 26, 0.6); border-radius: var(--radius-sm); border: 1px solid var(--border-glass);">
              <div style="font-size: 0.85rem; font-weight: 700; color: var(--accent-amber-bright);">
                The Top 0.25% Whale Effect
              </div>
              <div style="font-size: 0.84rem; color: var(--text-muted); margin-top: 4px;">
                Just <strong>1,023 bills over $5,000</strong> hold over <strong>$11.3 Million</strong> in debt. Focusing collection resources on these 1,000 rows reclaims nearly a fifth of all delinquent revenue.
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- Tax Flag & Lien Classifications -->
      <section class="section" aria-label="Tax Flag Codes">
        <div class="section-header-box">
          <h2 class="section-title">
            <span class="title-icon">⚖️</span>
            Tax Status & Lien Classifications
          </h2>
          <p class="section-subtitle">
            Georgia tax flag definitions indicating legal execution status, school tax obligations, and assessment dispute records.
          </p>
        </div>

        <div class="flag-cards-grid">
          <div class="flag-card">
            <div class="flag-header">
              <span class="flag-code-badge">Flag Code S</span>
              <span class="flag-count" style="color: var(--accent-emerald-bright);">{fmtInt(flags["S"])}</span>
            </div>
            <div class="flag-name">School & Standard Delinquency</div>
            <div class="flag-desc">
              Standard delinquent tax records including local public school district millage obligations.
            </div>
          </div>

          <div class="flag-card code-f">
            <div class="flag-header">
              <span class="flag-code-badge">Flag Code F</span>
              <span class="flag-count" style="color: #f43f5e;">{fmtInt(flags["F"])}</span>
            </div>
            <div class="flag-name">Fi.Fa. Lien Levy Executed</div>
            <div class="flag-desc">
              Official <em>Fieri Facias</em> tax lien writ issued authorizing sheriff levy and tax sales.
            </div>
          </div>

          <div class="flag-card code-a">
            <div class="flag-header">
              <span class="flag-code-badge">Flag Code A</span>
              <span class="flag-count" style="color: var(--accent-cyan-bright);">{fmtInt(flags["A"])}</span>
            </div>
            <div class="flag-name">Assessment Adjustment</div>
            <div class="flag-desc">
              Property tax assessment under formal appeal, review, or valuation correction.
            </div>
          </div>

          <div class="flag-card">
            <div class="flag-header">
              <span class="flag-code-badge">Flag Code T</span>
              <span class="flag-count" style="color: #c084fc;">{fmtInt(flags["T"])}</span>
            </div>
            <div class="flag-name">Transfer of Claim</div>
            <div class="flag-desc">
              Tax debt claim officially transferred or assigned to a third-party lien investor.
            </div>
          </div>
        </div>
      </section>

      <!-- Revenue Recovery Simulator -->
      <section class="section" aria-label="Policy Simulator">
        <Simulator />
      </section>

      <!-- Pipeline Architecture -->
      <section class="section" aria-label="Pipeline Architecture">
        <div class="section-header-box">
          <h2 class="section-title">
            <span class="title-icon">⚙️</span>
            The Data Pipeline & Ingestion Engine
          </h2>
          <p class="section-subtitle">
            How 9,915 raw PDF pages are parsed offline into byte-identical structured JSON analytics.
          </p>
        </div>

        <PipelineFlow />
      </section>

      <!-- Ethics Banner -->
      <section class="section" aria-label="Ethics and Privacy Statement">
        <div class="ethics-banner">
          <h2>
            🛡️ Privacy & Public Record Ethics Standard
          </h2>
          <p>
            This dataset originates from public records published by the DeKalb County Tax Commissioner. 
            To safeguard individual taxpayer privacy, this dashboard publishes <strong>aggregate statistical analysis only</strong> — strictly excluding individual names, street addresses, or single-property lookups. 
          </p>
        </div>
      </section>

    </main>

    <!-- Site Footer -->
    <footer class="site-footer">
      <div class="wrap footer-content">
        <div>
          <strong style="color: var(--text-main);">GAScout Analytics</strong> — Built with Astro v5
          <div style="margin-top: 4px;">
            Data Source: DeKalb County Tax Commissioner (Delinquent Tax Cross Reference Listing)
          </div>
        </div>
        <div style="text-align: right; font-family: var(--font-mono); font-size: 0.78rem;">
          <div>County Run Date: {run_date}</div>
          <div style="margin-top: 4px;">
            <a href="https://github.com/itshumpf" target="_blank" rel="noopener noreferrer">github.com/itshumpf</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Interactive Client Script for Multi-Metric Toggle -->
    <script is:inline>
      (function() {
        const toggleButtons = document.querySelectorAll('#year-chart-toggles .btn-toggle');
        const rows = document.querySelectorAll('#year-bars-container .bar-item-row');

        const maxValues = {
          due: Math.max(...Array.from(rows).map(r => parseFloat(r.dataset.due || '0'))),
          records: Math.max(...Array.from(rows).map(r => parseInt(r.dataset.records || '0', 10))),
          avg: Math.max(...Array.from(rows).map(r => parseFloat(r.dataset.avg || '0')))
        };

        function fmtCompact(val, metric) {
          if (metric === 'records') return Math.round(val).toLocaleString();
          if (metric === 'due') {
            if (val >= 1000000) return `$${(val / 1000000).toFixed(2)}M`;
            if (val >= 10000) return `$${(val / 1000).toFixed(1)}K`;
            return `$${val.toFixed(2)}`;
          }
          if (metric === 'avg') {
            return `$${val.toFixed(2)}`;
          }
          return val.toString();
        }

        toggleButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            const metric = btn.dataset.metric;
            if (!metric) return;

            toggleButtons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const maxVal = maxValues[metric];

            rows.forEach(row => {
              const val = parseFloat(row.dataset[metric] || '0');
              const pct = Math.max((val / maxVal) * 100, 5);

              const fillEl = row.querySelector('.bar-fill');
              const textEl = row.querySelector('.bar-text-val');

              if (fillEl && textEl) {
                fillEl.style.width = `${pct}%`;
                
                // Update fill colors based on metric
                fillEl.className = `bar-fill fill-${metric}`;
                textEl.textContent = fmtCompact(val, metric);
              }
            });
          });
        });
      })();
    </script>
  </body>
</html>
