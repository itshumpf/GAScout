---
import "../styles/global.css";
import StatCard from "../components/StatCard.astro";
import Simulator from "../components/Simulator.astro";
import PipelineFlow from "../components/PipelineFlow.astro";
import CountySelector from "../components/CountySelector.astro";
import manifest from "../data/manifest.json";

export async function getStaticPaths() {
  const files = import.meta.glob('../data/counties/*.json', { eager: true });
  
  return manifest.map((item) => {
    const filePath = `../data/counties/${item.slug}.json`;
    const data = (files[filePath] as any).default || files[filePath];
    return {
      params: { county: item.slug },
      props: { dashboard: data },
    };
  });
}

const { dashboard } = Astro.props;

const {
  generated_at,
  county,
  source,
  run_date,
  records,
  owners,
  total_due,
  by_year,
  amount_bands,
  flags,
  median_due,
  largest_single_bill,
  seat,
  fips,
  is_live,
  status,
  adapter,
  legal_organ,
  has_amounts,
  sale_date,
  note,
} = dashboard;

const countyName = county.charAt(0).toUpperCase() + county.slice(1);

// Three display modes:
//  - showMoney:    live delinquent-roll data WITH dollar amounts (e.g. DeKalb)
//  - showSaleList: live sale-list data with NO dollar amounts (e.g. Fulton —
//                  the Sheriff levy list publishes parcel + address only)
//  - else:         adapter planned / roadmap
// has_amounts defaults to true so existing live counties are unaffected.
const showSaleList = is_live && has_amounts === false;
const showMoney = is_live && !showSaleList;

const fmtInt = (n: number): string => (n || 0).toLocaleString("en-US");
const fmtMoney = (n: number): string =>
  "$" + (n || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmtCompactMoney = (n: number): string =>
  n >= 1_000_000
    ? `$${(n / 1_000_000).toFixed(2)}M`
    : n >= 10_000
      ? `$${(n / 1_000).toFixed(1)}K`
      : fmtMoney(n);

const years = by_year
  ? Object.entries(by_year).map(([year, v]: [string, any]) => ({
      year,
      records: v.records,
      due: v.due,
      avgDue: v.due / v.records,
    }))
  : [];

const yearRange = years.length ? `${years[0].year}–${years[years.length - 1].year}` : "N/A";
const maxYearDue = years.length ? Math.max(...years.map((y) => y.due)) : 0;
const avgRecordsPerOwner = owners ? (records / owners).toFixed(1) : "0";
const y2025PctDebt = (by_year && by_year["2025"] && total_due) ? ((by_year["2025"].due / total_due) * 100).toFixed(1) : "0";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`GAScout ${countyName} County — Georgia Public Records Pipeline & Adapter Status (${seat}).`}
    />
    <title>GAScout — {countyName} County ({seat}) Public Records Pipeline</title>
  </head>
  <body>
    <!-- Site Header -->
    <header class="site-header">
      <div class="wrap">
        <div class="hero-grid">
          <div>
            <div class="brand-row">
              <div class="logo-badge">
                <span class="pulse-dot" style={is_live ? "" : "background: #eab308; box-shadow: 0 0 8px #eab308;"}></span>
                {is_live ? "LIVE PRODUCTION INGESTION" : "PIPELINE ADAPTER ROADMAP"}
              </div>
              <span style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted); background: var(--bg-glass); padding: 4px 12px; border-radius: 999px; border: 1px solid var(--border-glass);">
                county: <strong style={`color: ${is_live ? "#10b981" : "#eab308"};`}>{county.toUpperCase()} ({seat.toUpperCase()})</strong>
              </span>
            </div>
            
            <h1 class="hero-title">
              GA<span class="brand-highlight">Scout</span> {countyName} County
            </h1>
            
            <p class="hero-subtitle">
              {showSaleList
                ? `Production OCR pipeline parsing the Sheriff's levy/tax-sale list — ${fmtInt(records)} properties scheduled for the ${sale_date} sale. Parcel ID and address only; no dollar figures are published on this source.`
                : is_live
                ? `Production public-records ingestion pipeline parsing ${fmtInt(records)} real tax lien records.`
                : `Registry coverage roadmap entry for ${countyName} County (Seat: ${seat}, FIPS ${fips}). Adapter planned for ${legal_organ}.`}
            </p>

            <div class="hero-meta">
              <span>🏛️ Legal Organ: <strong>{legal_organ}</strong></span>
              <span>•</span>
              <span>⚡ Adapter: <strong>{adapter}</strong></span>
              <span>•</span>
              <span>📍 FIPS: <strong>{fips}</strong></span>
            </div>

            <!-- 159 County Selector Bar -->
            <CountySelector currentSlug={county} />
          </div>

          <div class="quick-action-badge glass-panel">
            {showSaleList ? (
              <>
                <span class="qa-number">{fmtInt(records)}</span>
                <span class="qa-label">Properties on the {sale_date} Sale List</span>
                <div style="font-family: var(--font-mono); font-size: 0.76rem; color: #10b981; margin-top: 4px;">
                  Sale number · parcel ID · address (no dollar figures published)
                </div>
              </>
            ) : showMoney ? (
              <>
                <span class="qa-number">{fmtCompactMoney(total_due)}</span>
                <span class="qa-label">Total {countyName} Uncollected Debt</span>
                <div style="font-family: var(--font-mono); font-size: 0.76rem; color: #10b981; margin-top: 4px;">
                  Across {fmtInt(records)} Property Bills
                </div>
              </>
            ) : (
              <>
                <span class="qa-number" style="font-size: 1.6rem; color: #eab308;">ADAPTER PLANNED</span>
                <span class="qa-label">FIPS {fips} • {seat}</span>
                <div style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--text-muted); margin-top: 4px;">
                  Zero synthetic numbers published
                </div>
              </>
            )}
          </div>
        </div>
      </div>
    </header>

    <main class="wrap main-content">
      {showMoney ? (
        <>
          <!-- 6-Metric Stat Row for Live County -->
          <section class="stats-grid" aria-label={`${countyName} Summary Statistics`}>
            <StatCard title="TOTAL RECORDS" value={fmtInt(records)} subtitle="Delinquent line items in county dataset" variant="emerald" />
            <StatCard title="UNIQUE OWNERS" value={fmtInt(owners)} subtitle={`Avg ${avgRecordsPerOwner} delinquent bills per owner`} variant="cyan" />
            <StatCard title="TOTAL DEBT DUE" value={fmtCompactMoney(total_due)} subtitle={`Cumulative tax debt (${yearRange})`} variant="cyan" />
            <StatCard title="MEDIAN BILL" value={fmtMoney(median_due)} subtitle="50th percentile delinquent bill" variant="amber" />
            <StatCard title="LARGEST BILL" value={fmtCompactMoney(largest_single_bill)} subtitle="Single highest tax lien balance" variant="amber" />
            <StatCard title="TAX YEARS" value={yearRange} subtitle={`${y2025PctDebt}% of debt in 2025 cycle`} variant="cyan" />
          </section>

          <!-- Multi-Metric Year Trend Section -->
          <section class="analysis-section glass-panel">
            <div class="section-header">
              <span class="section-icon">📊</span>
              <div>
                <h2>Tax Year Trend Analysis</h2>
                <p>Delinquency distribution across {countyName} tax cycles ({yearRange}).</p>
              </div>
            </div>

            <div class="chart-view active" id="view-due">
              <div class="custom-bar-chart">
                {years.map((y) => {
                  const widthPct = Math.max(4, Math.round((y.due / maxYearDue) * 100));
                  return (
                    <div class="chart-row">
                      <div class="year-label">{y.year}</div>
                      <div class="bar-container">
                        <div class="bar-fill bar-due" style={`width: ${widthPct}%`}>
                          <span class="bar-value">{fmtCompactMoney(y.due)}</span>
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </section>

          <!-- Revenue Recovery Simulator -->
          <Simulator totalDue={total_due} records={records} owners={owners} amountBands={amount_bands} />
        </>
      ) : showSaleList ? (
        <!-- Live Sale-List County (parcel + address only, no dollar figures) -->
        <section class="analysis-section glass-panel" style="padding: 32px 24px;">
          <div class="section-header">
            <span class="section-icon">🏛️</span>
            <div>
              <h2>{countyName} County — Sheriff Tax Sale List</h2>
              <p>{fmtInt(records)} properties scheduled for the {sale_date} levy sale, parsed by OCR from the county's published PDF.</p>
            </div>
          </div>

          <section class="stats-grid" aria-label={`${countyName} Sale List Summary`} style="margin-top: 20px;">
            <StatCard title="AUCTION PROPERTIES" value={fmtInt(records)} subtitle={`Scheduled for the ${sale_date} Sheriff Sale`} variant="emerald" />
            <StatCard title="DATA LANE" value="Sheriff Tax Sale Levies" subtitle="Courthouse step auction list" variant="cyan" />
            <StatCard title="INGESTION METHOD" value="Scanned PDF (OCR)" subtitle="Fulton Sheriff Official Roll" variant="amber" />
            <StatCard title="PARCEL MAPPING" value="143 of 148" subtitle="5 scan-noise rows address-only" variant="cyan" />
          </section>

          <p style="color: var(--text-muted); max-width: 720px; margin: 24px auto 0 auto; line-height: 1.6; text-align: center; font-size: 0.92rem;">
            {note || "Fulton's Sheriff levy-sale list publishes a sale number, parcel ID, and property address for each property — no owner names and no dollar amounts. This dashboard reports the count of properties scheduled for sale, not a debt total, because the source contains none."}
          </p>
        </section>
      ) : (
        <!-- Audit-Proof Adapter Status Panel for Planned County -->
        <section class="analysis-section glass-panel" style="text-align: center; padding: 40px 20px;">
          <div style="font-size: 2.5rem; margin-bottom: 12px;">🛡️</div>
          <h2 style="color: var(--text-primary); font-size: 1.5rem; margin-bottom: 8px;">
            {countyName} County Pipeline Adapter — Roadmap Status
          </h2>
          <p style="color: var(--text-muted); max-width: 650px; margin: 0 auto 24px auto; line-height: 1.6;">
            This route represents <strong>{countyName} County (FIPS {fips}, Seat: {seat})</strong> in the statewide GAScrape registry.
            The statutory legal organ for this county is <em>{legal_organ}</em>.
          </p>

          <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; margin-bottom: 30px;">
            <div style="background: var(--bg-glass); border: 1px solid var(--border-glass); padding: 14px 20px; border-radius: 8px; font-family: var(--font-mono); text-align: left;">
              <div style="font-size: 0.72rem; color: var(--text-muted);">ADAPTER TYPE</div>
              <div style="color: #38bdf8; font-weight: 700;">{adapter}</div>
            </div>
            <div style="background: var(--bg-glass); border: 1px solid var(--border-glass); padding: 14px 20px; border-radius: 8px; font-family: var(--font-mono); text-align: left;">
              <div style="font-size: 0.72rem; color: var(--text-muted);">LEGAL ORGAN</div>
              <div style="color: var(--text-primary); font-weight: 700;">{legal_organ}</div>
            </div>
            <div style="background: var(--bg-glass); border: 1px solid var(--border-glass); padding: 14px 20px; border-radius: 8px; font-family: var(--font-mono); text-align: left;">
              <div style="font-size: 0.72rem; color: var(--text-muted);">DATA INTEGRITY POLICY</div>
              <div style="color: #10b981; font-weight: 700;">Zero Mock / Real Ingest Only</div>
            </div>
          </div>

          <div style="font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-muted); background: rgba(15, 23, 42, 0.6); padding: 12px 20px; border-radius: 8px; display: inline-block;">
            💡 View live production data on the <a href="/" style="color: #10b981; text-decoration: underline;">DeKalb County Production Pipeline ($62.7M)</a>
          </div>
        </section>
      )}

      <!-- 6-Node Single Row Pipeline Architecture -->
      <PipelineFlow />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="wrap footer-content">
        <div>
          <div style="font-weight: 700; color: var(--text-primary); margin-bottom: 4px;">
            GAScout Intelligence Engine — {countyName} County ({seat})
          </div>
          <div>
            Built with Astro & Vanilla CSS. Production pipeline anchored by DeKalb County Tax Commissioner listings.
          </div>
        </div>
        <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted);">
          Sub-second static build • 100/100 Lighthouse Performance
        </div>
      </div>
    </footer>
  </body>
</html>
