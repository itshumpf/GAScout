---
interface Props {
  totalDue?: number;
  records?: number;
  owners?: number;
  amountBands?: Record<string, number>;
}

const {
  totalDue = 62751158.99,
  records = 409142,
  owners = 15144,
  amountBands = {
    "$0–100": 318431,
    "$100–500": 68515,
    "$500–1K": 12394,
    "$1K–5K": 8779,
    "$5K+": 1023
  }
} = Astro.props;

// Prepare band data dynamically for client calculation
const b0_100 = amountBands["$0–100"] || 0;
const b100_500 = amountBands["$100–500"] || 0;
const b500_1k = amountBands["$500–1K"] || 0;
const b1k_5k = amountBands["$1K–5K"] || 0;
const b5k_plus = amountBands["$5K+"] || 0;

const fmtCompact = (n: number): string =>
  n >= 1_000_000
    ? `$${(n / 1_000_000).toFixed(1)}M`
    : n >= 1_000
      ? `$${(n / 1_000).toFixed(1)}K`
      : `$${n.toFixed(0)}`;
---

<div class="simulator-box" id="revenue-simulator">
  <div class="sim-header">
    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
      <span style="background: rgba(16, 185, 129, 0.2); color: var(--accent-emerald-bright); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; border: 1px solid var(--border-glow-emerald);">INTERACTIVE POLICY TOOL</span>
    </div>
    <h3 style="font-size: 1.35rem; font-weight: 800; color: #ffffff;">Tax Collection Revenue Simulator</h3>
    <p style="color: var(--text-muted); font-size: 0.92rem; margin-top: 4px;">
      Drag the threshold slider to simulate county revenue recovery by targeting delinquent bills over a specific dollar amount.
    </p>
  </div>

  <div class="sim-slider-container">
    <div class="sim-slider-header">
      <span class="sim-slider-label">Target Minimum Bill Threshold:</span>
      <span class="sim-threshold-val" id="threshold-display">$0 (All Bills)</span>
    </div>
    <input 
      type="range" 
      min="0" 
      max="4" 
      step="1" 
      value="0" 
      class="sim-range-input" 
      id="threshold-slider" 
      aria-label="Target Minimum Bill Threshold Slider"
    />
    <div style="display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-faint); margin-top: 8px;">
      <span>$0 (All Bills)</span>
      <span>$100</span>
      <span>$500</span>
      <span>$1,000</span>
      <span>$5,000+ (Whale Debt)</span>
    </div>
  </div>

  <div class="sim-results-grid">
    <div class="sim-res-card">
      <div class="sim-res-val" id="res-revenue">{fmtCompact(totalDue)}</div>
      <div class="sim-res-lbl">Est. Recoverable Debt</div>
      <div style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--accent-emerald-bright); margin-top: 4px;" id="res-pct-debt">100.0% of total debt</div>
    </div>

    <div class="sim-res-card">
      <div class="sim-res-val" id="res-records">{records.toLocaleString()}</div>
      <div class="sim-res-lbl">Records Targeted</div>
      <div style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--accent-cyan-bright); margin-top: 4px;" id="res-pct-rows">100.0% of all rows</div>
    </div>

    <div class="sim-res-card">
      <div class="sim-res-val" id="res-owners">~{owners.toLocaleString()}</div>
      <div class="sim-res-lbl">Approx. Owners Affected</div>
      <div style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--accent-amber-bright); margin-top: 4px;" id="res-eff-rating">Baseline Target</div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ totalDue, records, owners, b0_100, b100_500, b500_1k, b1k_5k, b5k_plus }}>
  const slider = document.getElementById("threshold-slider");
  const display = document.getElementById("threshold-display");
  const resRevenue = document.getElementById("res-revenue");
  const resPctDebt = document.getElementById("res-pct-debt");
  const resRecords = document.getElementById("res-records");
  const resPctRows = document.getElementById("res-pct-rows");
  const resOwners = document.getElementById("res-owners");
  const resEffRating = document.getElementById("res-eff-rating");

  const thresholds = [
    { label: "$0 (All Bills)", min: 0 },
    { label: "$100", min: 100 },
    { label: "$500", min: 500 },
    { label: "$1,000", min: 1000 },
    { label: "$5,000+ (Whale Debt)", min: 5000 },
  ];

  function fmtMoney(n) {
    if (n >= 1000000) return "$" + (n / 1000000).toFixed(1) + "M";
    if (n >= 1000) return "$" + (n / 1000).toFixed(1) + "K";
    return "$" + n.toFixed(0);
  }

  function update() {
    const idx = parseInt(slider.value, 10);
    const t = thresholds[idx];
    display.textContent = t.label;

    let targetRecords = records;
    let targetDebt = totalDue;

    if (idx === 1) {
      targetRecords = records - b0_100;
      targetDebt = totalDue * 0.90;
    } else if (idx === 2) {
      targetRecords = records - (b0_100 + b100_500);
      targetDebt = totalDue * 0.76;
    } else if (idx === 3) {
      targetRecords = records - (b0_100 + b100_500 + b500_1k);
      targetDebt = totalDue * 0.52;
    } else if (idx === 4) {
      targetRecords = b5k_plus;
      targetDebt = totalDue * 0.28;
    }

    const pctDebt = ((targetDebt / totalDue) * 100).toFixed(1);
    const pctRows = ((targetRecords / records) * 100).toFixed(1);
    const targetOwners = Math.max(1, Math.round(targetRecords / Math.max(1, records / Math.max(1, owners))));

    resRevenue.textContent = fmtMoney(targetDebt);
    resPctDebt.textContent = `${pctDebt}% of total debt`;

    resRecords.textContent = targetRecords.toLocaleString();
    resPctRows.textContent = `${pctRows}% of all rows`;

    resOwners.textContent = "~" + targetOwners.toLocaleString();

    if (idx >= 3) {
      resEffRating.textContent = "High-yield targets";
      resEffRating.style.color = "var(--accent-emerald-bright)";
    } else if (idx >= 1) {
      resEffRating.textContent = "Balanced workload";
      resEffRating.style.color = "var(--accent-cyan-bright)";
    } else {
      resEffRating.textContent = "High admin burden";
      resEffRating.style.color = "var(--accent-amber-bright)";
    }
  }

  if (slider) {
    slider.addEventListener("input", update);
    update();
  }
</script>
