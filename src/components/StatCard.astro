---
interface Props {
  value: number | string;
  title: string;
  subtitle?: string;
  variant?: "emerald" | "cyan" | "amber" | "default";
}

const { value, title, subtitle, variant = "default" } = Astro.props;
const variantClass = variant !== "default" ? `accent-${variant}` : "";
---

<div class:list={["stat-card-glass", variantClass]}>
  <span class="stat-value">{value}</span>
  <span class="stat-label">{title}</span>
  {subtitle && <div class="stat-desc">{subtitle}</div>}
</div>
