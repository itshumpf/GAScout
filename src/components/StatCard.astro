---
interface Props {
  value: number | string;
  label: string;
  description?: string;
  variant?: "emerald" | "cyan" | "amber" | "default";
}

const { value, label, description, variant = "default" } = Astro.props;
const variantClass = variant !== "default" ? `accent-${variant}` : "";
---

<div class:list={["stat-card-glass", variantClass]}>
  <span class="stat-value">{value}</span>
  <span class="stat-label">{label}</span>
  {description && <div class="stat-desc">{description}</div>}
</div>
